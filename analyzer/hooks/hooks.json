{
  "description": "Hooks for analyzer plugin - worktree normalization and context injection",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/analyzer-pre-command.sh",
        "timeout": 30
      }]
    }],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [{
          "type": "command",
          "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/analyzer-pre-skill.sh",
          "timeout": 30
        }]
      },
      {
        "matcher": "Task",
        "hooks": [{
          "type": "command",
          "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/analyzer-pre-task.sh",
          "timeout": 60
        }]
      }
    ]
  }
}
