{
  "description": "Global hooks for review-loop plugin - skill pre-validation",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/review-loop-pre-tool.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
